```mermaid
flowchart TB
    %% Trust Boundary 1: Untrusted Public Internet
    subgraph TB1 ["Trust Boundary 1: Public Ingress (Untrusted Zone)"]
        UserBrowser["🌐 Employee / Client Browser<br/>(Normal User)"]
        AttackerClient["💀 Threat Actor / Adversary<br/>(SSJS / NoSQLi / XSS Payloads)"]
    end

    %% Trust Boundary 2: Application Container Tier
    subgraph TB2 ["Trust Boundary 2: Web Application Tier (Docker Container: web)"]
        direction TB
        subgraph NodeGoatApp ["Node.js / Express Web Application (Port 4000)"]
            MiddleLayer["Middleware & Session Tier<br/>• Session Cookie Handler<br/>• CSURF Protection<br/>• Error Handling Middleware"]
            ContrRoute["Contributions Controller<br/>• Retirement Calculations<br/>• SSJS Remediation (parseInt)"]
            AllocRoute["Allocations Controller<br/>• Portfolio Asset Display<br/>• NoSQLi Remediation (Native $gt)"]
            MemoRoute["Memos Controller<br/>• Internal Notice Board<br/>• XSS Sanitization (marked options)"]
            AuthRoute["User / Auth Controller<br/>• Login / Registration<br/>• Bcrypt Salted Hashing (10 rounds)"]
        end
    end

    %% Trust Boundary 3: Database Persistence Tier
    subgraph TB3 ["Trust Boundary 3: Database Persistence Tier (Docker Container: db)"]
        MongoDB[("🗄️ MongoDB NoSQL Database (Port 27017)<br/>• 'users' Collection (Salted Hashes)<br/>• 'allocations' Collection<br/>• 'memos' Collection<br/>• 'counters' Sequence Collection")]
    end

    %% Trust Boundary 4: CI/CD Pipeline & Secrets
    subgraph TB4 ["Trust Boundary 4: DevSecOps CI/CD Automation Tier (GitHub Actions)"]
        direction LR
        Gate1["Gate 1: Semgrep SAST<br/>(OWASP Top 10 Rules)"]
        Gate2["Gate 2: npm audit SCA<br/>(Dependency CVE Check)"]
        Gate3["Gate 3: Gitleaks<br/>(Secret Leak Detection)"]
        Gate4["Gate 4: Trivy<br/>(Container Image Scanner)"]
    end

    %% Connections
    UserBrowser -->|"HTTP / REST (Port 4000)"| MiddleLayer
    AttackerClient -->|"Exploit Payloads (eval injection, $where injection)"| MiddleLayer

    MiddleLayer --> ContrRoute
    MiddleLayer --> AllocRoute
    MiddleLayer --> MemoRoute
    MiddleLayer --> AuthRoute

    ContrRoute -->|"Update Allocation Data"| MongoDB
    AllocRoute -->|"Type-Safe Query Filter {$gt}"| MongoDB
    MemoRoute -->|"Store Sanitized Memos"| MongoDB
    AuthRoute -->|"Bcrypt Hash Verification"| MongoDB

    TB4 -.->|"Automated Security Gates on Push"| NodeGoatApp

    classDef public fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#1e293b;
    classDef app fill:#e0e7ff,stroke:#6366f1,stroke-width:2px,color:#1e293b;
    classDef data fill:#d1fae5,stroke:#10b981,stroke-width:2px,color:#1e293b;
    classDef cicd fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#1e293b;

    class UserBrowser,AttackerClient public;
    class MiddleLayer,ContrRoute,AllocRoute,MemoRoute,AuthRoute,NodeGoatApp app;
    class MongoDB data;
    class Gate1,Gate2,Gate3,Gate4 cicd;
```
