# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
# Copy this file to .env and configure local values for testing

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
# Local SQLite default (runs offline out-of-the-box without external server)
DB_PATH=./data/taskshield.sqlite
# Or PostgreSQL/MongoDB connection string when deployed via Docker
# DB_URI=postgres://taskshield_user:CHANGE_ME_PASSWORD@db:5432/taskshield_db

# Security & Cryptography (JWT)
# In production, use a strong 256-bit secret injected via Vault or GitHub Secrets
JWT_SECRET=super_secure_random_production_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=15m

# Administrative Seed Credentials (Used only on initial empty DB seeding)
INITIAL_ADMIN_EMAIL=admin@devsecops.local
INITIAL_ADMIN_PASSWORD=AdminSecurePass!2026

# Vault Integration (Optional runtime secret injection)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/taskshield
